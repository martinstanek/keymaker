@inject IEventingService Eventing;
@inject IKeymakerClient Client;

<MudCard Style="margin-bottom: 10px">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@ChallengeInfo.CertificateName</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid Justify="Justify.FlexEnd">
            <MudItem xs="6">
                <ValueLabel Label="Challenge mode:" Value=@ChallengeInfo.ChallengeMode/>
                <ValueLabel Label="DNS mode:" Value=@ChallengeInfo.DnsMode />
                <ValueLabel Label="Store mode:" Value=@ChallengeInfo.StoreMode />
                <ValueLabel Label="Store target:" Value=@ChallengeInfo.StoreTarget />
                <ValueLabel Label="Domain:" Value=@ChallengeInfo.Domain />
                <ValueLabel Label="Contact:" Value=@ChallengeInfo.Contact />
                <ValueLabel Label="Organization:" Value=@ChallengeInfo.Organization />
            </MudItem>
            <MudItem xs="6">
                <ValueLabel Label="Obtained:" Value=@Obtained/>
                <ValueLabel Label="Expiry:" Value=@Expiry />
                <ValueLabel Label="Next renewal:" Value=@NextRenewal/>
                <ValueLabel Label="Issuer:" Value=@ChallengeInfo.Issuer />
                <ValueLabel Label="Autorenewal:" Value=@ChallengeInfo.IsAutoRenewalEnabled.ToString() />
                <ValueLabel Label="Renew every (hours):" Value=@ChallengeInfo.RenewEveryHours.ToString() />
                <ValueLabel Label="Keymaker state:" Value=@ChallengeInfo.Status />
            </MudItem>
        </MudGrid>
        <div style="margin-top: 15px; display: flex; justify-content: center" >
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@OnTriggerClick">trigger challenge</MudButton>
        </div>
    </MudCardContent>
</MudCard>